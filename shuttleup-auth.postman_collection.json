					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"testuser@shuttleup.dev\",\n  \"password\": \"Password123\",\n  \"name\": \"Test User\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/sign-up/email",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"auth",
						"sign-up",
						"email"
					]
				}
			},
			"response": []
		},
		{
